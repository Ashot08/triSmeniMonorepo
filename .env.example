# === App ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ts_user
POSTGRES_PASSWORD=ts_pass
POSTGRES_DB=ts_game
DATABASE_URL=postgresql://ts_user:ts_pass@localhost:5432/ts_game

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# === JWT ===
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === MinIO / S3 ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_pass
S3_BUCKET=ts-game-assets
S3_REGION=us-east-1

# === OAuth ===
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_CALLBACK_URL=http://localhost:3000/api/v1/auth/vk/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3000/api/v1/auth/yandex/callback

TELEGRAM_BOT_TOKEN=
